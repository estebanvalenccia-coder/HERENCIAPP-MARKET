# Herencia Market — ejemplo de configuración de backend
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://www.herenciamarket.es,https://herenciamarket.es,https://herenciapp-market.vercel.app

# Base principal
DATABASE_URL=

# Compatibilidad legacy temporal
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Administración
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Opcional pero recomendado: secreto Base32 para códigos TOTP (Google Authenticator/Authy/1Password)
ADMIN_TOTP_SECRET=
JWT_SECRET=

# Stripe — secretos solo en Railway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=Herencia Market <onboarding@resend.dev>
ADMIN_ORDER_EMAIL=
STORE_EMAIL=

# Reparto — STORE_ADDRESS es origen privado, no dirección pública de una tienda
GOOGLE_MAPS_API_KEY=
STORE_ADDRESS=
SHIPPING_BASE_PRICE=5
SHIPPING_STEP_KM=3
SHIPPING_STEP_PRICE=3

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=herencia-market-media
R2_PUBLIC_URL=

# HERENCIA SALES — solo servidor
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
SALES_AI_TIMEOUT_MS=30000
AI_IMAGE_TIMEOUT_MS=45000

# HERENCIA Neural server-to-server
NEURAL_SERVICE_URL=
NEURAL_ADMIN_TOKEN=
HERENCIA_NEURAL_TOKEN=
NEURAL_PROXY_TIMEOUT_MS=45000

# Integraciones opcionales
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Dropshipping / Supplier Hub — solo servidor
# URL HTTPS de un conector autorizado que cree pedidos en el proveedor.
SUPPLIER_AUTOPILOT_WEBHOOK_URL=
# Token compartido para órdenes salientes y webhooks de tracking entrantes.
SUPPLIER_AUTOPILOT_WEBHOOK_TOKEN=
