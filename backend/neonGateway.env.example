# Required for Neon primary storage
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional internal port; Railway public PORT is left to Railway.
LEGACY_BACKEND_PORT=3002

# Future Cloudflare R2 media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=herencia-market-media
R2_PUBLIC_URL=

# Dropshipping / Supplier Hub — solo servidor
# URL HTTPS de un conector autorizado que cree pedidos en el proveedor.
SUPPLIER_AUTOPILOT_WEBHOOK_URL=
# Token compartido para órdenes salientes y webhooks de tracking entrantes.
SUPPLIER_AUTOPILOT_WEBHOOK_TOKEN=
